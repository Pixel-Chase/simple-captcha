# ---------------------------------------------------------------
# 本地开发默认配置（入库；不要在这里放真实密钥）
# 个人覆盖项写到同目录的 .env（已被 .gitignore 忽略），run-dev.sh 会优先采用 .env 中的值；
# 命令行临时指定的变量优先级最高，例如：PORT=4000 ./run-dev.sh
# ---------------------------------------------------------------

# ===== 服务 =====
PORT=3321
HOST=0.0.0.0
# Gin 只接受 debug / release / test
GIN_MODE=debug
API_PREFIX=/api/v1

# ===== Redis =====
# 本地起一个：docker run -d --name simple-captcha-redis -p 6379:6379 redis:7-alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 安全 =====
# S2S 二次验证密钥；留空表示 /captchas/states 不鉴权（仅限本地）
API_KEY=
# 演示站跑在 http://localhost:8000，本地放开跨域
CORS_ALLOW_ORIGINS=*

# ===== 管理后台 =====
# 本地直接用明文密码，演示站默认账号 admin / demo123
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=demo123
ADMIN_SESSION_TTL=8h
