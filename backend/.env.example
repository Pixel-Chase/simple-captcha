# ---------------------------------------------------------------
# 生产配置模板（可选）：不需要 .env 也能启动，只在要覆盖端口、证书、可信代理网段等部署参数时复制为 .env
#   cp .env.example .env
# .env 已被 .gitignore 与 .dockerignore 忽略，不会入库、也不会被打进镜像；
# docker-compose.yml 通过 env_file 读取它，run-dev.sh 也会把它作为本地覆盖项。
# 含 $ 的值必须用单引号包裹，避免被 shell / compose 当变量展开。
# 完整变量说明见 README「环境变量参考」。
# ---------------------------------------------------------------

# ===== 服务 =====
GIN_MODE=release

# ===== 安全 =====
# S2S 鉴权不走配置：在管理后台为每个业务后端创建应用，用各自的应用密钥查询 /captchas/states/:key
# 跨域不走配置：在管理后台「接入应用」里为每个应用填写允许来源（前端页面的 origin），名单外的请求直接拒绝
# 可信代理网段，按实际反向代理地址收窄；管理后台的同源判定只在直连来源命中这里时才采信 X-Forwarded-Host / X-Forwarded-Proto。
# 默认值为私有网段，不含 127.0.0.1：nginx 与后端进程同机、转发到 127.0.0.1 时写 127.0.0.1,::1（设置后替换默认值）
# TRUSTED_PROXIES=10.0.0.0/8

# ===== 验证码与风控 =====
# 出题、校验、工作量证明与风控评分策略（难度、阈值、有效期等 23 项）改在管理后台「策略配置」修改，保存后立即生效。
# TLS / HTTP2 指纹（可选）：由 fingerproxy 等 TLS 终结代理注入的请求头名，只在直连来源命中 TRUSTED_PROXIES 时采信；
# 不配置则整条链路关闭。列表文件给出"指纹 → 浏览器家族"映射与拒绝列表，不配置时指纹只记录到遥测不计分。
# 部署示例见 deploy/fingerproxy/
# RISK_TLS_FINGERPRINT_HEADER=X-JA4-Fingerprint
# RISK_HTTP2_FINGERPRINT_HEADER=X-HTTP2-Fingerprint
# RISK_TLS_FINGERPRINT_LIST=./data/tls-fingerprints.json

# ===== 管理后台（背景图 + 接入应用）=====
# 管理后台随服务常驻开启，页面内嵌在服务里：http://<服务地址>/console/（与 API 同源，无需跨域）
# 首次启动后打开控制台完成初始化：初始化口令打印在容器日志里（每次启动未初始化时都会换新）：
#   docker compose logs backend | grep -A4 初始化口令
# 用户名与密码在初始化页面设置；遗失可执行 docker compose exec backend ./simple-captcha reset-admin 重新初始化
# backend/images 需对容器内 uid 1001 可写：chown -R 1001:1001 backend/images
# 管理员账号与接入应用保存在工作目录下的 data/captcha.db（镜像内 /app/data），compose 中挂载为具名卷，务必保留（丢失后应用密钥全部失效）
ADMIN_SESSION_TTL=2h
ADMIN_MAX_UPLOAD_SIZE=5242880
