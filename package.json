{
  "name": "simple-captcha-workspace",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "sdk"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "npm --prefix sdk run playground:build",
    "lint": "npm --prefix sdk run typecheck && npm --prefix sdk run lint"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "tsx": "^4.23.15",
    "vite": "8.3.5"
  }
}
