# ---------------------------------------------------------------
# 生产配置模板：复制为 .env 后填写
#   cp .env.example .env
# .env 已被 .gitignore 与 .dockerignore 忽略，不会入库、也不会被打进镜像；
# docker-compose.yml 通过 env_file 读取它，run-dev.sh 也会把它作为本地覆盖项。
# 含 $ 的值必须用单引号包裹，避免被 shell / compose 当变量展开。
# 完整变量说明见 README「环境变量参考」。
# ---------------------------------------------------------------

# ===== 服务 =====
GIN_MODE=release
API_PREFIX=/api/v1

# ===== Redis（必填）=====
# compose 部署并连接宿主机 Redis 时可填 host.docker.internal
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2
REDIS_POOL_SIZE=20

# ===== 安全 =====
# S2S 鉴权不走配置：在管理后台为每个业务后端创建应用，用各自的应用密钥查询 /captchas/states/:key
# 允许的前端来源，多个用逗号分隔；生产环境不要用 *
CORS_ALLOW_ORIGINS=https://example.com
CORS_ALLOW_CREDENTIALS=false
# 可信代理网段，按实际反向代理地址收窄
# TRUSTED_PROXIES=10.0.0.0/8

# ===== 验证码与风控 =====
CAPTCHA_EXPIRE_TIME=5m
CAPTCHA_MAX_ATTEMPTS=5
# 同一 IP 每分钟出题与提交超过该次数后，后续题目逐级加难（0 关闭）；
# 验证码请求不会因 IP 被拒绝：企业或运营商 NAT 后大量用户共用出口 IP
CAPTCHA_IP_ESCALATE_PER_MINUTE=30
ENABLE_METRICS=true
# CAPTCHA_DEFAULT_DIFFICULTY=3
# RISK_MODE=enforce

# ===== 管理后台（背景图 + 接入应用）=====
# 管理后台随服务常驻开启，页面内嵌在服务里：http://<服务地址>/console/（与 API 同源，无需跨域）
# 管理员密码首次启动时随机生成并打印在容器日志里（只显示一次）：
#   docker compose logs backend | grep -A6 管理后台初始密码
# 首次登录后必须修改；遗失可执行 docker compose exec backend ./simple-captcha reset-admin-password
# backend/images 需对容器内 uid 1001 可写：chown -R 1001:1001 backend/images
# 凭据与接入应用保存在工作目录下的 data（镜像内 /app/data），compose 中挂载为具名卷，务必保留（丢失后应用密钥全部失效）
ADMIN_USERNAME=admin
ADMIN_SESSION_TTL=2h
ADMIN_MAX_UPLOAD_SIZE=5242880
