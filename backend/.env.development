# ---------------------------------------------------------------
# 本地开发默认配置（入库；不要在这里放真实密钥）
# 个人覆盖项写到同目录的 .env（已被 .gitignore 忽略），run-dev.sh 会优先采用 .env 中的值；
# 命令行临时指定的变量优先级最高，例如：PORT=4000 ./run-dev.sh
# ---------------------------------------------------------------

# ===== 服务 =====
PORT=3321
HOST=0.0.0.0
# Gin 只接受 debug / release / test
GIN_MODE=debug

# ===== 管理后台 =====
# 与生产一致：首次启动在终端打印初始化口令，打开控制台填写口令并设置用户名与密码。
# 账号与接入应用保存在 backend/data/captcha.db（已被 .gitignore 忽略）；
# 遗失密码执行 ./run-dev.sh reset-admin 重新初始化
ADMIN_SESSION_TTL=8h
