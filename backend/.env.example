# ---------------------------------------------------------------
# 生产配置模板：复制为 .env 后填写
#   cp .env.example .env
# .env 已被 .gitignore 与 .dockerignore 忽略，不会入库、也不会被打进镜像；
# docker-compose.yml 通过 env_file 读取它，run-dev.sh 也会把它作为本地覆盖项。
# 含 $ 的值（如 bcrypt 哈希）必须用单引号包裹，避免被 shell / compose 当变量展开。
# 完整变量说明见 README「环境变量参考」。
# ---------------------------------------------------------------

# ===== 服务 =====
GIN_MODE=release
API_PREFIX=/api/v1

# ===== Redis（必填）=====
# compose 部署并连接宿主机 Redis 时可填 host.docker.internal
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2
REDIS_POOL_SIZE=20

# ===== 安全 =====
# S2S 二次验证密钥（必填）：业务后端查询 /captchas/states/:key 时携带
API_KEY=change-me
# 允许的前端来源，多个用逗号分隔；生产环境不要用 *
CORS_ALLOW_ORIGINS=https://example.com
CORS_ALLOW_CREDENTIALS=false
# 可信代理网段，按实际反向代理地址收窄
# TRUSTED_PROXIES=10.0.0.0/8

# ===== 验证码与风控 =====
CAPTCHA_EXPIRE_TIME=5m
CAPTCHA_MAX_ATTEMPTS=5
CAPTCHA_IP_RATE_LIMIT=30
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS=100
ENABLE_METRICS=true
# CAPTCHA_DEFAULT_DIFFICULTY=3
# RISK_MODE=enforce

# ===== 管理后台（登录 + 背景图管理）=====
# 开启后 backend/images 需对容器内 uid 1001 可写：chown -R 1001:1001 backend/images
ADMIN_ENABLED=false
ADMIN_USERNAME=admin
# 生成哈希：make hash-password（或 docker run --rm -i <镜像> ./simple-captcha hash-password）
ADMIN_PASSWORD_HASH=''
ADMIN_SESSION_TTL=2h
ADMIN_MAX_UPLOAD_SIZE=5242880
